APP_NAME=Scutta API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./scutta.db
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

SESSION_COOKIE_NAME=scutta_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_DAYS=400
SESSION_REFRESH_DAYS=7
SESSION_MAX_PER_USER=5
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

SETTLEMENT_DRAWS=["중간고사 이후","종강총회"]
SETTLEMENT_PRIZES={"matches":"경기 수 부문 상품","wins":"승리 수 부문 상품","losses":"패배 수 부문 상품","opponents":"상대 수 부문 상품"}
